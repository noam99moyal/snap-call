// Snap Call rooms on Cloudflare: one Worker, one Durable Object per room (see worker.mjs).
{
  "name": "snap-call-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2025-09-01",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  // SQLite-backed Durable Objects work on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
